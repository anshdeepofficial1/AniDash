{
  "id": "/watch/",
  "name": "AniDash — Anime, without the noise",
  "short_name": "AniDash",
  "description": "Discover anime, explore episodes and stream with AniDash.",
  "start_url": "/watch/",
  "scope": "/watch/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#090c11",
  "theme_color": "#090c11",
  "categories": [
    "entertainment"
  ],
  "icons": [
    {
      "src": "/watch/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/watch/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/watch/assets/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}