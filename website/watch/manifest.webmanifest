{
  "id": "/",
  "name": "AniDash — Discover & Watch Anime",
  "short_name": "AniDash",
  "description": "Discover, search and watch anime with a fast, app-like player: episode lists, resume playback, quality and subtitle controls, library and watch history.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d1310",
