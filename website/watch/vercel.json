{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/watch/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/anidash",
      "destination": "https://anidashweb.vercel.app/api/anidash"
    },
    {
      "source": "/api/media",
      "destination": "https://anidashweb.vercel.app/api/media"
    },
    {
      "source": "/watch",
      "destination": "/index.html"
    },
    {
      "source": "/watch/",
      "destination": "/index.html"
    },
    {
      "source": "/watch/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/watch/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/watch/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/watch/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/watch/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/watch/vendor/(.*)",
      "destination": "/vendor/$1"
    },
    {
      "source": "/watch/assets/(.*)",
      "destination": "/assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/watch/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/watch/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/watch/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/watch/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/watch/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}