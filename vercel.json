{
  "outputDirectory": "website",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/watch",
      "destination": "/watch/index.html"
    }
  ],
  "headers": [
    {
      "source": "/watch/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/watch"
        }
      ]
    }
  ]
}
